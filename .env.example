# Postgres. May be the engine's database (the service only touches the `pothos`
# schema) or its own.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pothos

# Listen address.
# BIND_ADDR=0.0.0.0:8090

# Admits every /v1/* call. At least 32 bytes. Keep it on the product layer's
# server; end users never call this service.
POTHOS_CALLER_SECRET=

# The engine whose insights export is mirrored. Set both or neither; neither
# turns the sweeper off and the service runs on whatever is already mirrored.
# ENGINE_BASE_URL=http://localhost:8080
# ENGINE_EXPORT_SECRET=

# Sweeper cadence in seconds (default 300). SWEEP_DISABLED=1 also turns it off.
# SWEEP_INTERVAL_SECS=300

# Weights file (default ./pothos.toml).
# POTHOS_WEIGHTS=pothos.toml
