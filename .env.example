# Postgres. May be the engine's database (the service only touches the `pothos`
# schema) or its own.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pothos

# Listen address.
# BIND_ADDR=0.0.0.0:8090

# Admits every /v1/* call. At least 32 bytes. Keep it on the product layer's
# server; end users never call this service.
POTHOS_CALLER_SECRET=

# The engine whose insights export is mirrored. Set both or neither; neither
# turns the sweeper off and the service runs on whatever is already mirrored.
# ENGINE_BASE_URL=http://localhost:8080
# ENGINE_EXPORT_SECRET=

# Sweeper cadence in seconds (default 300). SWEEP_DISABLED=1 also turns it off.
# Run the sweeper on one instance only; set SWEEP_DISABLED=1 on the others.
# SWEEP_INTERVAL_SECS=300

# Weights file (default ./pothos.toml).
# POTHOS_WEIGHTS=pothos.toml

# OpenAI-compatible model for the concept, autobio and judge steps (POST {LLM_BASE_URL}/chat/completions).
# Set all three or none; none leaves phrases matching literally and turns the
# autobio and judge off. The steps run inside the sweeper, so they also need
# ENGINE_*. The phrases include sexual preferences and deal-breakers: pick a
# model that records them without refusing.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=

# Most phrases the concept step decides per sweep (default 200).
# CONCEPT_MAX_PER_TICK=200

# Autobio: users updated per sweep (default 50; 0 turns the autobio step off)
# and the least time between two updates of one user (default 3600 s, at most
# 31536000, one year), so a chat's turn-by-turn changes land as one batch.
# AUTOBIO_MAX_PER_TICK=50
# AUTOBIO_MIN_INTERVAL_SECS=3600

# Judge: a candidates request queues the pairs among its top JUDGE_TOP_K
# candidates that lack a fresh grade (default 10); pairs judged per sweep
# (default 100; 0 turns the judge step off).
# JUDGE_TOP_K=10
# JUDGE_MAX_PER_TICK=100

# Per-step model names; LLM_BASE_URL and LLM_API_KEY are shared. Unset: LLM_MODEL.
# AUTOBIO_MODEL=
# JUDGE_MODEL=
